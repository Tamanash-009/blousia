# GEMINI_API_KEY: Required for Gemini AI API calls (Style Advisor & Chatbot).
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Places Autocomplete & Maps integrations.
GOOGLE_MAPS_PLATFORM_KEY="your_google_maps_platform_key_here"

# CLIENT_URL: The URL of the frontend (for CORS)
CLIENT_URL="http://localhost:3000"

# PORT: Backend server port
PORT=3000
